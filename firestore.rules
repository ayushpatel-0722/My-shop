rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function role() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            ? 'admin'
            : (exists(/databases/$(database)/documents/employees/$(request.auth.uid))
                ? 'employee'
                : 'customer'));
    }

    function companyId() {
      return request.auth.token.companyId != null
        ? request.auth.token.companyId
        : (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.companyId
            : (exists(/databases/$(database)/documents/employees/$(request.auth.uid))
                ? get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyId
                : ''));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isEmployee() {
      return isSignedIn() && (
        request.auth.token.role == 'employee' ||
        exists(/databases/$(database)/documents/employees/$(request.auth.uid))
      );
    }

    function isCompanyAdmin(cId) {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/companies/$(cId)/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.companyId == cId)
      );
    }

    function isCompanyEmployee(cId) {
      return isSignedIn() && (
        request.auth.token.role == 'employee' ||
        exists(/databases/$(database)/documents/companies/$(cId)/employees/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyId == cId)
      );
    }

    function isCompanyStaff(cId) {
      return isCompanyAdmin(cId) || isCompanyEmployee(cId);
    }

    function isValidHomeExploreCategory(data) {
      return data.shopId is string && data.shopId.size() > 0 && data.shopId.size() <= 128
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128
        && data.isActive is bool
        && (data.displayOrder is int || data.displayOrder is float)
        && (!('shopName' in data) || data.shopName == null || (data.shopName is string && data.shopName.size() <= 200))
        && (!('categoryName' in data) || data.categoryName == null || (data.categoryName is string && data.categoryName.size() <= 200))
        && (!('createdBy' in data) || data.createdBy == null || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidHomeTrendingItem(data) {
      return data.shopId is string && data.shopId.size() > 0 && data.shopId.size() <= 128
        && data.itemType in ['product', 'category']
        && data.isActive is bool
        && (data.displayOrder is int || data.displayOrder is float)
        && (!('productId' in data) || data.productId == null || (data.productId is string && data.productId.size() <= 128))
        && (!('categoryId' in data) || data.categoryId == null || (data.categoryId is string && data.categoryId.size() <= 128))
        && (!('shopName' in data) || data.shopName == null || (data.shopName is string && data.shopName.size() <= 200))
        && (!('productName' in data) || data.productName == null || (data.productName is string && data.productName.size() <= 200))
        && (!('categoryName' in data) || data.categoryName == null || (data.categoryName is string && data.categoryName.size() <= 200))
        && (!('createdBy' in data) || data.createdBy == null || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidOrderCancellation(data) {
      return data.orderStatus == 'cancelled'
        && (!('cancellationReason' in data) || data.cancellationReason == null || (data.cancellationReason is string && data.cancellationReason.size() <= 500))
        && (!('cancelledAt' in data) || data.cancelledAt == null || (data.cancelledAt is string && data.cancelledAt.size() <= 64))
        && (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('stockRestored' in data) || data.stockRestored == null || data.stockRestored is bool)
        && (!('statusHistory' in data) || data.statusHistory == null || (data.statusHistory is list && data.statusHistory.size() <= 50));
    }

    function isValidOrderPaymentVerification(data) {
      return (!('paymentVerifiedBy' in data) || data.paymentVerifiedBy == null || (data.paymentVerifiedBy is string && data.paymentVerifiedBy.size() <= 200))
        && (!('paymentVerifiedAt' in data) || data.paymentVerifiedAt == null || (data.paymentVerifiedAt is string && data.paymentVerifiedAt.size() <= 64) || data.paymentVerifiedAt is timestamp);
    }

    // =========================================================================
    // 1. COMPANIES (Root collection & Hierarchical Tree)
    // =========================================================================
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn()
                     || (request.resource.data.name is string
                         && request.resource.data.companyPassword is string
                         && request.resource.data.name.size() > 0
                         && request.resource.data.companyPassword.size() > 0);
      allow update: if isCompanyAdmin(companyId);
      allow delete: if false;

      // ---- /companies/{companyId}/admins/{adminId} ---------------------------
      match /admins/{adminId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/employees/{employeeId} ---------------------
      match /employees/{employeeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/categories/{categoryId} --------------------
      // Ordering is admin-managed: sortOrder drives the customer-facing
      // category order and productIds holds the curated "In Category" product
      // order. Only a company admin can create/update/delete categories, and
      // the ordering fields are explicitly admin-gated on update as well.
      match /categories/{categoryId} {
        allow read: if true;
        allow create: if isCompanyAdmin(companyId);
        allow update: if isCompanyAdmin(companyId)
          && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['sortOrder', 'productIds'])
              || isCompanyAdmin(companyId));
        allow delete: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/products/{productId} ----------------------
      match /products/{productId} {
        allow read: if true;
        allow write: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/orders/{orderId} --------------------------
      match /orders/{orderId} {
        allow read: if isSignedIn() &&
          (resource.data.userId == request.auth.uid || isCompanyStaff(companyId));
        allow create: if isSignedIn()
          && (isCompanyStaff(companyId) || (
            (!('paymentVerifiedBy' in request.resource.data) || request.resource.data.paymentVerifiedBy == null)
            && (!('paymentVerifiedAt' in request.resource.data) || request.resource.data.paymentVerifiedAt == null)
            && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus != 'done')
          ))
          && isValidOrderPaymentVerification(request.resource.data);
        allow update: if (isCompanyStaff(companyId) && isValidOrderPaymentVerification(request.resource.data)) || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && resource.data.orderStatus == 'pending'
          && request.resource.data.orderStatus == 'cancelled'
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'userId', 'companyId', 'totalAmount', 'subtotal',
                'discountAmount', 'deliveryCharge', 'paymentStatus',
                'paymentMethod', 'amountPaid', 'transactionRef', 'paidAt',
                'paymentVerifiedBy', 'paymentVerifiedAt',
                'items', 'address', 'pincode', 'pickupShop',
                'voucherId', 'voucherCode', 'createdAt',
                'assignedEmployeeId', 'employeePackingDone'
              ])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'orderStatus', 'cancellationReason', 'cancelledAt',
                'statusHistory', 'stockRestored', 'updatedAt'
              ])
          && isValidOrderCancellation(request.resource.data)
        );
        allow delete: if false;

        match /items/{itemId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn();
        }
      }

      // ---- /companies/{companyId}/vouchers/{voucherId} ----------------------
      match /vouchers/{voucherId} {
        allow read: if true;
        allow write: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/banners/{bannerId} ------------------------
      match /banners/{bannerId} {
        allow read: if true;
        allow write: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/delivery_charges/{pincode} ----------------
      match /delivery_charges/{pincode} {
        allow read: if true;
        allow write: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/reviews/{reviewId} ------------------------
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isCompanyAdmin(companyId) || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow delete: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/recommendations/{recId} -------------------
      match /recommendations/{recId} {
        allow read: if true;
        allow write: if isCompanyAdmin(companyId);
      }

      // ---- /companies/{companyId}/notifications/{notificationId} ------------
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isCompanyAdmin(companyId));
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isCompanyAdmin(companyId));
        allow delete: if isCompanyAdmin(companyId);
      }
    }

    // =========================================================================
    // 2. ROOT COLLECTIONS (Stay flat)
    // =========================================================================

    // Users / Shoppers (customers browse multiple companies)
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (userId == request.auth.uid || isAdmin());
    }

    // Platform-wide Ads Banners
    match /ads_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media Links
    match /media_links/{mediaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Home screen: Explore Categories
    match /home_explore_categories/{entryId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isCompanyAdmin(request.resource.data.shopId)
        && isValidHomeExploreCategory(request.resource.data);
      allow update: if isSignedIn()
        && isCompanyAdmin(resource.data.shopId)
        && isCompanyAdmin(request.resource.data.shopId)
        && isValidHomeExploreCategory(request.resource.data);
      allow delete: if isSignedIn()
        && isCompanyAdmin(resource.data.shopId);
    }

    // Home screen: Trending Now
    match /home_trending_now/{itemId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isCompanyAdmin(request.resource.data.shopId)
        && isValidHomeTrendingItem(request.resource.data);
      allow update: if isSignedIn()
        && isCompanyAdmin(resource.data.shopId)
        && isCompanyAdmin(request.resource.data.shopId)
        && isValidHomeTrendingItem(request.resource.data);
      allow delete: if isSignedIn()
        && isCompanyAdmin(resource.data.shopId);
    }

    // =========================================================================
    // 3. COLLECTION GROUP RULES (For session restore & global feeds)
    // =========================================================================
    match /{path=**}/admins/{adminId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/employees/{employeeId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/products/{productId} {
      allow read: if true;
    }
    match /{path=**}/categories/{categoryId} {
      allow read: if true;
    }
    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin' || request.auth.token.role == 'employee');
    }
    match /{path=**}/vouchers/{voucherId} {
      allow read: if true;
    }
    match /{path=**}/banners/{bannerId} {
      allow read: if true;
    }
    match /{path=**}/delivery_charges/{pincode} {
      allow read: if true;
    }
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }
    match /{path=**}/recommendations/{recId} {
      allow read: if true;
    }
    match /{path=**}/notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid);
    }

    // =========================================================================
    // 4. LEGACY ROOT FALLBACK (Ensures existing flat documents remain accessible)
    // =========================================================================
    match /admins/{adminId} {
      allow read, write: if isSignedIn() && (adminId == request.auth.uid || isAdmin());
    }
    match /employees/{employeeId} {
      allow read, write: if isSignedIn() && (employeeId == request.auth.uid || isAdmin());
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSignedIn() && role() == 'admin' &&
        request.resource.data.companyId == companyId();
      allow update, delete: if isSignedIn() && role() == 'admin' &&
        resource.data.companyId == companyId();
    }
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && role() == 'admin' &&
        resource.data.companyId == companyId() &&
        (!('categoryId' in request.resource.data) ||
         get(/databases/$(database)/documents/categories/$(request.resource.data.categoryId))
           .data.companyId == companyId());
    }
    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /delivery_charges/{pincode} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /recommendations/{recId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
  }
}
