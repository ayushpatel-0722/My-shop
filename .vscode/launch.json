{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "My Shop (Firebase)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart"
        },
        {
            "name": "My Shop (Mock data)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": ["--dart-define=USE_MOCK_DATA=true"]
        },
        {
            "name": "My Shop (Web :8080)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "args": ["--web-port", "8080"]
        }
    ]
}
